# Unset = on in development, off in production. Never overwrites an existing database.
SEED_DEMO_DATA=
# Fixed password for the sample-school logins, so they stay the same after every
# reload of the samples (needed on Vercel). Min 10 chars, letters + digits. Keep it secret.
SEED_DEMO_PASSWORD=
