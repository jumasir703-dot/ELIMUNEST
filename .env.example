# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_SESSION_SECRET: REQUIRED in production (min 32 chars). Signs login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_HEX_SECRET"

# DATA_DIR: Where the JSON database is stored. Point this at a persistent disk in production
# (e.g. /var/data on Render). Defaults to ./data when unset.
# DATA_DIR="/var/data"

# SMS provider for password reset codes (required in production; console log only in dev/test):
# Option A: Generic HTTP webhook accepting JSON { to, message }
# SMS_WEBHOOK_URL=""
# SMS_WEBHOOK_TOKEN=""
# Option B: Africa's Talking
# AT_USERNAME=""
# AT_API_KEY=""
# AT_SENDER_ID=""

# KV_REST_API_URL & KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN):
# Optional. Enable on Vercel / stateless hosts so newly created tenants, logins, and school data
# persist across deployments and code pushes instead of resetting with ephemeral /tmp storage.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

